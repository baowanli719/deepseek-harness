{
  "name": "@deepseek-ai/dsh-llm-gs-gateway",
  "description": "gsclaw model-gateway adapter: 127.0.0.1 loopback proxy swapping a per-boot placeholder token for the real gsclaw access token, and hot mirroring of server ClientConfig models into the llm provider volatile config",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-gs-gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-config-editor": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-gs-server": "workspace:*",
    "@deepseek-ai/dsh-sensitive-policy": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-config-editor": {
      "optional": true
    },
    "@deepseek-ai/dsh-sensitive-policy": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-launch-environment": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent-default-model": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-config-editor": "workspace:*",
    "@deepseek-ai/dsh-gs-server": "workspace:*",
    "@deepseek-ai/dsh-launch-environment": "workspace:*",
    "@deepseek-ai/dsh-sensitive-policy": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*"
  }
}
