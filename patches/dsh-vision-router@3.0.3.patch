+// GS keeps server model identities and uses Vision only as auxiliary tools.
+export function desktopToolConfig(config = {}) {
+  if (config.desktopToolMode !== true) return config
+  return { ...config, autoWrapProviders: false, wrappedProviders: [],
+    wrapperRoute: '', chainRoute: '', routing: false, stealth: false,
+    rewriteImages: false, freeFallback: false, onboardingSeen: true,
+    providers: [], provider: '', fallbacks: [], backgroundBenchmarking: 'off' }
+}
+
+export function installDesktopToolAdmission(ctx, config, rewriteImageBlocks) {
+  if (config.desktopToolMode !== true) return
+  const enabled = () => {
+    const settings = ctx.get('settings')?.get?.('vision-router')
+    return (settings?.tool ?? config.tool) !== false &&
+      (settings?.httpProviders ?? config.httpProviders ?? []).length > 0
+  }
+  ctx.provide('visionToolAdmission', {
+    canHandle(agent) { return !!agent?.session && enabled() },
+    projectTextInput(options) {
+      return options.sessionId && enabled()
+        ? rewriteImageBlocks(options.messages).messages : options.messages
+    },
+  })
+}
